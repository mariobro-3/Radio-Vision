menu "WiFi Sonar STA Settings"

config WIFI_SONAR_STA_LABEL
    string "Station label (matches diagram)"
    default "S1"

config WIFI_SONAR_AP_SSID
    string "Target AP SSID"
    default "sonar-ap-20mhz"

config WIFI_SONAR_AP_PASSWORD
    string "Target AP password"
    default "sonarCSI2025"

config WIFI_SONAR_STATIC_IP
    string "Static IPv4 (leave 0.0.0.0 for DHCP)"
    default "192.168.4.2"

config WIFI_SONAR_STATIC_GW
    string "Gateway IPv4 (SoftAP IPv4)"
    default "192.168.4.1"

config WIFI_SONAR_STATIC_NETMASK
    string "Netmask"
    default "255.255.255.0"

config WIFI_SONAR_COLLECTOR_IP
    string "Collector IPv4 (Windows host)"
    default "192.168.4.10"

config WIFI_SONAR_COLLECTOR_PORT
    int "Collector UDP port"
    range 1024 65535
    default 40123

config WIFI_SONAR_SAMPLE_QUEUE_DEPTH
    int "CSI queue depth"
    range 8 128
    default 32

endmenu


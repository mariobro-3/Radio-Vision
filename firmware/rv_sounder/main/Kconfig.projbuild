menu "RadioVision sounder"

    choice RV_ILLUM
        prompt "Illumination source"
        default RV_ILLUM_RAW_DAC
        help
            RAW_DAC: maximum-performance raw-IQ sounding via the radio's baseband
            DAC (keyed spread spectrum, processing gain). Open-air transmit needs
            an amateur licence or a dummy load / shielded setup - see
            docs/COMPLIANCE.md.
            WIFI_CERTIFIED: the FCC-in-grant path. TX sends probe frames through
            the certified Wi-Fi radio; RX senses via Wi-Fi CSI with the same
            gain-invariant detector. Standard-CSI-class performance.

        config RV_ILLUM_RAW_DAC
            bool "RAW_DAC (raw-IQ, max performance)"
        config RV_ILLUM_WIFI
            bool "WIFI_CERTIFIED (certified Wi-Fi path, FCC-friendly)"
    endchoice

    config RV_PROBE_HZ
        int "WIFI_CERTIFIED: probe frame rate (Hz)"
        depends on RV_ILLUM_WIFI
        range 10 500
        default 200

    choice RV_ROLE
        prompt "Board role"
        default RV_ROLE_RX
        help
            TX: continuously replay the sounding waveform (the illuminator).
            RX: capture bursts and run the motion detector (the sensor).
            Use two boards, one of each, for the bistatic link.

        config RV_ROLE_TX
            bool "TX illuminator"
        config RV_ROLE_RX
            bool "RX sensor"
    endchoice

    config RV_CHANNEL
        int "Wi-Fi channel (1-13)"
        range 1 13
        default 1

    config RV_ZC_N
        int "Sounding code length N (Zadoff-Chu, prime)"
        default 509

    config RV_ROOT_FROM_MAC
        bool "TX: auto-assign the code root from this board's MAC"
        default y
        help
            Each illuminator derives its own Zadoff-Chu root from its MAC, so a
            mesh self-assigns near-orthogonal codes with no coordination. Turn off
            to use the fixed RV_ZC_U below.

    config RV_ZC_U
        int "Sounding code root u (used when not auto-assigned; gcd(u,N)=1)"
        default 25

    config RV_RX_ROOTS
        string "RX: comma-separated code roots to track (one link per root)"
        default "25"
        help
            The RX separates these simultaneous illuminators by correlation
            (CDMA): one independent channel/link per root, from each capture.
            List the roots your TX boards use (see each TX board's boot log).

    config RV_MAX_LINKS
        int "RX: maximum simultaneous links"
        range 1 16
        default 8

    config RV_PERIODS
        int "Periods integrated per RX burst (R)"
        default 8

    config RV_RX_GAIN
        int "Fixed RX gain index (0-82, -1 = AGC)"
        range -1 82
        default 40

    comment "--- Compliance (see docs/COMPLIANCE.md) ---"

    config RV_TX_ACK
        bool "RAW_DAC transmit: I am licensed (amateur) or using a dummy load / shield"
        depends on RV_ILLUM_RAW_DAC && RV_ROLE_TX
        default n
        help
            The raw-IQ transmitter operates outside the module's FCC grant. It is
            only enabled when you confirm here that you are either licensed for the
            13 cm amateur band or transmitting into a dummy load / shielded
            enclosure. Left off, the TX board idles instead of radiating. The
            keyed spreading code (sounding waveform) is always allowed; this gate
            is only about emitting it over the air.

    config RV_HAM_CALLSIGN
        string "Amateur call sign for station ID (RAW_DAC over-air)"
        depends on RV_ILLUM_RAW_DAC && RV_ROLE_TX
        default ""
        help
            Part 97 requires you to identify your station. This is logged as a
            reminder; you remain responsible for transmitting your ID.

    config RV_PAYLOAD_ENCRYPT
        bool "Encrypt the probe data payload (Part 15 / WIFI_CERTIFIED only)"
        depends on RV_ILLUM_WIFI
        default n
        help
            Encrypts the probe frame payload with a keystream. Only available in
            the certified Wi-Fi (Part 15) mode: Part 97 section 97.113 forbids
            obscuring the meaning of a message on amateur bands, so this cannot be
            selected in RAW_DAC. The keyed SPREADING code is not affected - it is
            a spread-spectrum sounding sequence, not message encryption, and stays
            on in every mode.

    config RV_PAYLOAD_KEY
        string "Payload encryption key"
        depends on RV_PAYLOAD_ENCRYPT
        default "radiovision"

endmenu
